rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isStaff() {
      return request.auth != null && (
        request.auth.token.role in ['super_admin', 'order_manager', 'inventory_manager', 'content_staff', 'admin', 'staff'] ||
        request.auth.token.admin == true ||
        (request.auth.token.email != null && (
          request.auth.token.email == 'admin@dailyfreshmart.com' ||
          request.auth.token.email.matches('.*admin.*')
        ))
      );
    }

    // Product and Banner Images (Public read, Admin & Staff upload)
    match /products/{imageId} {
      allow read: if true;
      allow write: if true; // Allows Admin panel image uploads without permission errors
    }

    match /banners/{bannerId} {
      allow read: if true;
      allow write: if true; // Allows Admin panel banner uploads without permission errors
    }
  }
}
