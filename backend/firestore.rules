rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function hasRole(role) {
      return isAuthenticated() && request.auth.token.role == role;
    }

    function isStaff() {
      return isAuthenticated() && (
        request.auth.token.role == 'super_admin' ||
        request.auth.token.role == 'order_manager' ||
        request.auth.token.role == 'inventory_manager' ||
        request.auth.token.role == 'content_staff'
      );
    }

    function isSuperAdmin() {
      return hasRole('super_admin');
    }

    function isOrderManager() {
      return hasRole('order_manager') || isSuperAdmin();
    }

    function isInventoryManager() {
      return hasRole('inventory_manager') || isSuperAdmin();
    }

    // Public Storefront Catalog & Settings (Read-only for public, Staff write)
    match /products/{productId} {
      allow read: if resource.data.status == 'active' || isStaff();
      allow create, update, delete: if isInventoryManager() || isSuperAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isInventoryManager() || isSuperAdmin();
    }

    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // User Profiles & Addresses (Owner or Staff)
    match /users/{userId} {
      allow read: if isOwner(userId) || isStaff();
      // Users can update their basic profile, but cannot mutate role or isBlocked
      allow create: if isOwner(userId) && (!request.resource.data.keys().hasAny(['role', 'isBlocked']));
      allow update: if isOwner(userId) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isBlocked'])) || isSuperAdmin();
    }

    match /addresses/{addressId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isStaff());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Wishlist
    match /wishlists/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Orders (Customer can only read their own orders; writes handled server-side / order manager)
    match /orders/{orderId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isStaff());
      // Customers cannot directly modify order status, payment status, or prices!
      allow write: if isOrderManager();
    }

    // Payments (Internal / Server-only)
    match /payments/{paymentId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isStaff());
      allow write: if isSuperAdmin();
    }

    // Reviews (Public read of approved reviews; authenticated users create pending review)
    match /reviews/{reviewId} {
      allow read: if resource.data.status == 'approved' || isStaff();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid && request.resource.data.status == 'pending';
      allow update, delete: if isStaff();
    }

    // Inventory Logs (Audited; Staff read-only; mutations via server backend)
    match /inventoryLogs/{logId} {
      allow read: if isInventoryManager();
      allow write: if false; // Server-only via Admin SDK
    }

    // Audit Logs (Super Admin only; mutations via server backend)
    match /auditLogs/{logId} {
      allow read: if isSuperAdmin();
      allow write: if false; // Server-only via Admin SDK
    }
  }
}
