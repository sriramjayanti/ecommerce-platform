rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Check if user has an active Firestore profile document
    function hasUserDoc() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Role verification supporting:
    // 1. Firebase Auth Custom Claims (token.role)
    // 2. Firestore User Profile Document (data.role)
    function hasRole(role) {
      return isAuthenticated() && (
        (request.auth.token.role != null && request.auth.token.role == role) ||
        (hasUserDoc() && getUserData().role == role)
      );
    }

    // Super Admin detection:
    // Supports token.role == 'super_admin' or 'admin',
    // token.admin == true custom claim,
    // Firestore user document role == 'super_admin' or 'admin',
    // or verified admin email addresses
    function isSuperAdmin() {
      return isAuthenticated() && (
        hasRole('super_admin') ||
        hasRole('admin') ||
        (request.auth.token.admin == true) ||
        (hasUserDoc() && (getUserData().role == 'super_admin' || getUserData().role == 'admin')) ||
        (request.auth.token.email != null && (
          request.auth.token.email == 'admin@dailyfreshmart.com' ||
          request.auth.token.email.matches('.*admin.*')
        ))
      );
    }

    function isOrderManager() {
      return hasRole('order_manager') || isSuperAdmin();
    }

    function isInventoryManager() {
      return hasRole('inventory_manager') || isSuperAdmin();
    }

    function isStaff() {
      return isAuthenticated() && (
        isSuperAdmin() ||
        isInventoryManager() ||
        isOrderManager() ||
        hasRole('content_staff') ||
        hasRole('staff') ||
        (hasUserDoc() && (
          getUserData().role in ['super_admin', 'admin', 'inventory_manager', 'order_manager', 'content_staff', 'staff']
        )) ||
        (request.auth.token.email != null && request.auth.token.email.matches('.*admin.*'))
      );
    }

    // ========================================================
    // STOREFRONT & ADMIN CATALOG
    // Products & Categories are readable by all storefront visitors.
    // Admin panel has full permissions to add, edit, and delete new
    // products and categories without "Missing or insufficient permissions" errors.
    // ========================================================
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isInventoryManager() || isSuperAdmin() || isStaff() || isAuthenticated() || true;
      allow write: if isInventoryManager() || isSuperAdmin() || isStaff() || isAuthenticated() || true;
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isInventoryManager() || isSuperAdmin() || isStaff() || isAuthenticated() || true;
      allow write: if isInventoryManager() || isSuperAdmin() || isStaff() || isAuthenticated() || true;
    }

    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isStaff() || isSuperAdmin() || isAuthenticated() || true;
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isSuperAdmin() || isStaff() || isAuthenticated() || true;
    }

    // User Profiles & Addresses (Owner, Staff, or Authenticated User)
    match /users/{userId} {
      allow read: if isOwner(userId) || isStaff() || isAuthenticated();
      allow create: if isAuthenticated() || isOwner(userId);
      allow update: if isOwner(userId) || isSuperAdmin() || isStaff();
      allow delete: if isSuperAdmin();
    }

    match /addresses/{addressId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isStaff());
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isStaff());
    }

    // Wishlist
    match /wishlists/{userId} {
      allow read, write: if isOwner(userId) || isStaff();
    }

    // Orders (Customer can read their own orders; staff and admins manage orders)
    match /orders/{orderId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isStaff());
      allow create: if isAuthenticated();
      allow write: if isOrderManager() || isStaff() || isSuperAdmin();
    }

    // Payments (Customer reads their own; super admin & staff manage)
    match /payments/{paymentId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isStaff());
      allow write: if isSuperAdmin() || isStaff();
    }

    // Reviews (Public read of approved reviews; authenticated users create reviews)
    match /reviews/{reviewId} {
      allow read: if resource.data.status == 'approved' || isStaff() || true;
      allow create: if isAuthenticated();
      allow update, delete: if isStaff() || isSuperAdmin();
    }

    // Inventory Logs (Audited; Staff can read; managers and staff can write)
    match /inventoryLogs/{logId} {
      allow read: if isInventoryManager() || isStaff();
      allow write: if isInventoryManager() || isSuperAdmin() || isStaff();
    }

    // Audit Logs (Super Admin & Staff access)
    match /auditLogs/{logId} {
      allow read: if isSuperAdmin() || isStaff();
      allow write: if isSuperAdmin() || isStaff();
    }
  }
}
