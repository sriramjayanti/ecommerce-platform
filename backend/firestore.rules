rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper authorization functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isStaff() {
      return isAuthenticated() && (
        request.auth.token.role == 'super_admin' ||
        request.auth.token.role == 'order_manager' ||
        request.auth.token.role == 'inventory_manager' ||
        request.auth.token.role == 'content_staff'
      );
    }

    // 1. Products: Public read for active catalog, write restricted to staff
    match /products/{productId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // 2. Categories: Public read for active categories, write restricted to staff
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // 3. Banners: Public read for active banners, write restricted to staff
    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // 4. Store Settings & Feature Flags: Public read, write restricted to staff
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // 5. User Profiles: Only owner or staff can read/write
    match /users/{userId} {
      allow read, write: if isOwner(userId) || isStaff();
    }

    // 6. Customer Delivery Addresses: Only owner or staff can read/write
    match /addresses/{addressId} {
      allow read, write: if (resource != null && isOwner(resource.data.userId))
                         || (request.resource != null && isOwner(request.resource.data.userId))
                         || isStaff();
    }

    // 7. Wishlists: Only owner or staff
    match /wishlists/{userId} {
      allow read, write: if isOwner(userId) || isStaff();
    }

    // 8. Orders: Customer reads own orders, creation permitted, status updates restricted to staff
    match /orders/{orderId} {
      allow read: if (resource != null && isOwner(resource.data.userId)) || isStaff();
      allow create: if isAuthenticated() || isStaff() || (request.resource.data.userId != null);
      allow update, delete: if isStaff();
    }

    // 9. Inventory Logs: Auditable logs restricted to staff
    match /inventoryLogs/{logId} {
      allow read: if isStaff();
      allow write: if isStaff();
    }

    // 10. Reviews: Public read, authenticated creation, moderation restricted to staff
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isStaff();
    }

    // 11. Audit Logs: Sensitive admin operations strictly staff only
    match /auditLogs/{logId} {
      allow read, write: if isStaff();
    }

    // 12. Default Deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
