rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Products (Public read, creation and edits for store management)
    match /products/{productId} {
      allow read, write: if true;
    }

    // Categories (Public read, creation and edits for store management)
    match /categories/{categoryId} {
      allow read, write: if true;
    }

    // Banners (Public read, creation and edits for store management)
    match /banners/{bannerId} {
      allow read, write: if true;
    }

    // Store Settings
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // User Profiles & Addresses
    match /users/{userId} {
      allow read, write: if true;
    }

    match /addresses/{addressId} {
      allow read, write: if true;
    }

    match /wishlists/{userId} {
      allow read, write: if true;
    }

    // Orders (Customer order placement and Admin management)
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // Inventory Logs
    match /inventoryLogs/{logId} {
      allow read, write: if true;
    }

    // Reviews
    match /reviews/{reviewId} {
      allow read, write: if true;
    }

    // Catch-all
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
